# Database. The owner role runs migrations/seed; app_user is what API and worker use.
DATABASE_OWNER_URL=postgres://erq_owner:erq_owner@localhost:54329/erq
DATABASE_URL=postgres://app_user:app_user_dev@localhost:54329/erq
APP_USER_PASSWORD=app_user_dev
REDIS_URL=redis://localhost:6379

# Credential encryption (AES-256-GCM). Generate: openssl rand -base64 32
ENCRYPTION_KEY_ID=dev-1
ENCRYPTION_KEY=
# Optional JSON map of retired key ids to base64 keys, so old ciphertext still decrypts
ENCRYPTION_OLD_KEYS=

# Supabase Auth. Set SUPABASE_JWKS_URL (asymmetric keys) OR SUPABASE_JWT_SECRET (HS256).
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# API
API_PORT=4000
LOG_LEVEL=info
# WEB_PUBLIC_URL is also the Shopify OAuth redirect host: the Shopify app's allowed redirect URL must be
# ${WEB_PUBLIC_URL}/connections/shopify/callback (no trailing slash).
WEB_PUBLIC_URL=http://localhost:3000

# Shopify (an empty value disables Shopify). API_PUBLIC_URL is the public base URL of this API (used for the webhook URL).
# The WORKER reads these three too: the key and secret for access token refresh, API_PUBLIC_URL for the daily webhook re-registration.
API_PUBLIC_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Leave empty for the default: read_products,read_inventory,read_locations,read_orders,read_all_orders
SHOPIFY_SCOPES=
# Admin API version the worker uses for sync queries, format YYYY-MM. Empty means the built-in default.
SHOPIFY_API_VERSION=

# Web
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
API_URL=http://localhost:4000
# Demo mode (Vercel demo without the API): the web app reads the database directly with DATABASE_URL.
# Use Supabase's transaction-mode pooler URL for the app_user role. Leave unset for the full app.
NEXT_PUBLIC_DEMO_MODE=

# Worker (optional)
SYNC_CONCURRENCY=5
